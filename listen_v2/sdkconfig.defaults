# BOX-3 has only the native USB-C (ESP32-S3 USB-Serial-JTAG). The default
# console is UART0 on GPIO43/44, which are NOT connected to the USB-C port,
# so printf/logs never reach the PC. Route the console to USB-Serial-JTAG.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# BOX-3 has 8MB Octal PSRAM. RE-ENABLED — the earlier "all-zero mic" bug
# that PSRAM was suspected of causing was actually the front button (GPIO1)
# hardware-muting the mic while held; PSRAM was never the real cause (ruled
# out by testing with it disabled — mic was STILL zero on GPIO1, only fixed
# by switching to the BOOT button). Recording buffer lives in PSRAM again so
# it isn't capped to a few seconds by internal-RAM scarcity.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# BOX-3 has 16MB flash but the default config assumed 2MB with a 1MB app
# partition (was 96% full). Custom table gives each app slot 4MB of headroom.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Rollback is what makes OTA safe to use on a box you can't physically reach.
# With this on, a freshly-flashed image boots in PENDING_VERIFY and the
# bootloader reverts to the previous slot unless the new image explicitly
# confirms itself. ota_mark_valid() only confirms AFTER the box has joined WiFi
# and reached its server, so an update that breaks networking undoes itself on
# the next reboot instead of stranding the box. Without this flag the OTA path
# still works but has no safety net — do not turn it off.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# A live wss:// reverse channel keeps an mbedTLS session (record buffers +
# parsed cert-bundle state) alive in INTERNAL SRAM for as long as it's
# connected — by default mbedTLS never uses PSRAM. Combined with the 64KB
# internal-SRAM ring buffer play_begin() allocates for every /play, this
# starves internal heap: xStreamBufferCreate() returns NULL, and nothing
# checked that, so playback_task's first touch of the (null) handle hit a
# FreeRTOS assert and crashed the box — MEASURED, the first time audio was
# ever actually played over the reverse channel in the field (DNS had blocked
# every earlier connection attempt, so this combination was never exercised
# before). 16MB PSRAM is sitting right there; move mbedTLS's buffers into it.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Default 512B header budget is too tight for a modern mobile browser's
# request headers (User-Agent, Accept-Language, Sec-CH-UA client hints, etc.)
# hitting the provisioning portal — was rejecting the /save POST with
# "header fields too long" before the handler ever ran.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
